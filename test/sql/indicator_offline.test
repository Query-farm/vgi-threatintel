# name: test/sql/indicator_offline.test
# description: Offline indicator typing / triage scalars (no network / no mock)
# group: [vgi_threatintel]

require-env VGI_THREATINTEL_WORKER

# haybarn-unittest does NOT autoload the extension for `require vgi` (it is
# silently SKIPPED). Load it explicitly instead.
statement ok
LOAD vgi;

statement ok
ATTACH 'threatintel' AS threatintel (TYPE vgi, LOCATION '${VGI_THREATINTEL_WORKER}');

# ---- indicator_type: every supported type ----

query T
SELECT threatintel.indicator_type('1.2.3.4');
----
ipv4

query T
SELECT threatintel.indicator_type('2001:4860:4860::8888');
----
ipv6

query T
SELECT threatintel.indicator_type('evil-domain.example');
----
domain

query T
SELECT threatintel.indicator_type('http://evil.com/payload.exe');
----
url

query T
SELECT threatintel.indicator_type('44d88612fea8a8f36de82e1278abb02f');
----
md5

query T
SELECT threatintel.indicator_type('da39a3ee5e6b4b0d3255bfef95601890afd80709');
----
sha1

query T
SELECT threatintel.indicator_type('44d88612fea8a8f36de82e1278abb02f44d88612fea8a8f36de82e1278abb02f');
----
sha256

# An unrecognized indicator surfaces as SQL NULL.
query I
SELECT threatintel.indicator_type('not an indicator') IS NULL;
----
true

# ---- is_private_ip: RFC1918 true, public false ----

query I
SELECT threatintel.is_private_ip('10.0.0.1');
----
true

query I
SELECT threatintel.is_private_ip('192.168.1.50');
----
true

query I
SELECT threatintel.is_private_ip('127.0.0.1');
----
true

query I
SELECT threatintel.is_private_ip('8.8.8.8');
----
false

# A non-IP is never "private" (so a NOT is_private_ip gate is safe).
query I
SELECT threatintel.is_private_ip('evil-domain.example');
----
false

# Compose the two scalars: type, then gate a would-be lookup on public IPs.
query I
SELECT count(*) FROM (VALUES ('10.0.0.1'), ('8.8.8.8'), ('evil-domain.example')) AS t(v)
WHERE threatintel.indicator_type(v) IS NOT NULL
  AND NOT threatintel.is_private_ip(v);
----
2

# ---- composed examples (examples.go): scalars + the indicator_types view ----

# triageBatchSQL: 4 of the 6 indicators need a lookup (not the private IP or
# the unrecognized string).
query TTTTT
WITH iocs(ioc) AS (
  VALUES ('185.220.101.1'), ('10.0.0.5'), ('malware-c2.example'),
         ('https://good.example/login'), ('44d88612fea8a8f36de82e1278abb02f'), ('not-an-indicator!!')
), typed AS (
  SELECT ioc,
         threatintel.main.indicator_type(ioc) AS kind,
         threatintel.main.is_private_ip(ioc) AS is_private
  FROM iocs
)
SELECT typed.ioc, typed.kind, t.description, typed.is_private,
       typed.kind IS NOT NULL AND NOT typed.is_private AS needs_lookup
FROM typed
LEFT JOIN threatintel.main.indicator_types AS t ON t.indicator_type = typed.kind
ORDER BY needs_lookup DESC, typed.ioc
----
185.220.101.1	ipv4	IPv4 address in dotted-quad notation	false	true
44d88612fea8a8f36de82e1278abb02f	md5	MD5 file hash (32 hexadecimal characters)	false	true
https://good.example/login	url	Absolute HTTP or HTTPS URL	false	true
malware-c2.example	domain	DNS domain name (hostname)	false	true
10.0.0.5	ipv4	IPv4 address in dotted-quad notation	true	false
not-an-indicator!!	NULL	NULL	false	false

# typeCoverageSQL: every type listed, absent types count 0.
query TI
WITH iocs(ioc) AS (
  VALUES ('185.220.101.1'), ('8.8.8.8'), ('10.0.0.5'), ('malware-c2.example'),
         ('44d88612fea8a8f36de82e1278abb02f'),
         ('e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'), ('not-an-indicator!!')
)
SELECT t.indicator_type, count(i.ioc) AS n_indicators
FROM threatintel.main.indicator_types AS t
LEFT JOIN iocs AS i ON threatintel.main.indicator_type(i.ioc) = t.indicator_type
GROUP BY t.indicator_type
ORDER BY t.indicator_type
----
domain	1
ipv4	3
ipv6	0
md5	1
sha1	0
sha256	1
url	0
